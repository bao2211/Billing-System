        <mxCell id="b_end" value="Return summary&#xa;{profile, run_output_dir,&#xa;processed_rows, skipped_rows}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1700" width="240" height="60" as="geometry"/></mxCell>
