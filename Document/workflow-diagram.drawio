        <mxCell id="s1" value="User visits /" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="140" height="40" as="geometry"/></mxCell>
        <mxCell id="s2" value="Login form&#xa;(username + password)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="s3" value="POST /api/login&#xa;{username, password}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="140" height="50" as="geometry"/></mxCell>
