  <diagram name="3. Export Pipeline (11 steps)" id="p3_export">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t3" value="&lt;b&gt;EXPORT PIPELINE CHI TIẾT — 11 BƯỚC (runExport, exportService.js L870)&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="b1" value="Bước 1: Validate &amp; Normalize Profile&#xa;validateProfile() → normalizeProfile()&#xa;Merge default, coerce types, check required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="d_v" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="550" y="180" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="e_invalid" value="Throw Error&#xa;(missing name/sheet/template)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="b2" value="Bước 2: createGoogleClients()&#xa;loadCredentials → OAuth2 → setCredentials&#xa;Sheets v4 + Slides v1 + Drive v3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="280" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="b3" value="Bước 3: readSheetValues()&#xa;sheets.spreadsheets.values.get&#xa;Range: 'sheet'!A1:ZZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="390" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="b4" value="Bước 4: buildRowRecords()&#xa;Header = values[header_idx-1]&#xa;Map row → {sheet_row, data:{header:cell}}&#xa;Skip empty rows, apply max_rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="b5" value="Bước 5: selectRecordsForExport()&#xa;resolveColumnName / inferSkipColumn&#xa;isZeroOrEmptyValue (strip ₫/accent)&#xa;Filter selected_sheet_rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="d_empty" value="Rows?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="550" y="740" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="e_empty" value="Return 'No non-empty rows'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="750" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="b6" value="Bước 6: resolveOutputRoot() + buildRunRoot()&#xa;buildTemplateContext (date/profile/sheet/row_slug)&#xa;applyTemplate → sanitizeFilename → ensureUniqueDir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="480" y="840" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="b7_start" value="Bước 7: FOR mỗi selected record (loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="940" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="b7" value="getRowSlug + buildTemplateContext&#xa;applyTemplate(copy_name_template)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="1000" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="b8" value="Bước 8: copyTemplate()&#xa;drive.files.copy(template_id,&#xa;{name, parents:[folder_id]})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="1070" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="b9" value="Bước 9: buildReplaceRequests() + batchReplace()&#xa;resolvePlaceholder (strategy)&#xa;transformReferenceValue (strategy)&#xa;slides.batchUpdate replaceAllText" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="1150" width="280" height="80" as="geometry"/></mxCell>
