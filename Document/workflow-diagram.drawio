        <mxCell id="d1" value="User exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="380" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="e_no_user" value="401 Unauthorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="s5" value="verifyPassword&#xa;scrypt(hash, salt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="480" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="d2" value="Password&#xa;match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="560" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="e_no_pass" value="401 Unauthorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="575" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="s6" value="Create session&#xa;Map.set(sid, {username,&#xa;role, allowed_profiles})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="480" y="660" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="sid = crypto.randomUUID()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="750" width="140" height="40" as="geometry"/></mxCell>
        <mxCell id="s8" value="Set cookie&#xa;sid; HttpOnly;&#xa;SameSite=Strict; Max-Age=86400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="820" width="200" height="60" as="geometry"/></mxCell>
