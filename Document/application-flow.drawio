          <mxGeometry x="40" y="1316" width="660" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="N1" value="&lt;b&gt;gcloud CLI KHÔNG dùng được&lt;/b&gt;&lt;br&gt;• token cấp cho client 32555940559.apps.googleusercontent.com (gcloud SDK), không phải client của app → refresh sẽ invalid_grant&lt;br&gt;• scope chỉ có cloud-platform / compute / appengine.admin / sqlservice.login / openid → thiếu Sheets, Slides, Drive (403)" style="fillColor=#f5f5f5;strokeColor=#666666;html=1;shape=note;size=14;fontSize=11;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1060" y="92" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N2" value="&lt;b&gt;Hai cái bẫy đã gặp&lt;/b&gt;&lt;br&gt;• include_granted_scopes=true → 400 invalid_request, vì client này dùng chung với VS Code và đã được cấp sẵn drive.file + youtube.readonly (không được yêu cầu cùng nhau)&lt;br&gt;• Bỏ tham số đó + tick checkbox consent là qua được" style="fillColor=#f5f5f5;strokeColor=#666666;html=1;shape=note;size=14;fontSize=11;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1060" y="286" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N3" value="&lt;b&gt;Đã xác minh 21/09/2026&lt;/b&gt;&lt;br&gt;• Sheets: profile 13 → 8 dòng · Đất Thánh → 13 dòng · HỌC PHÍ TIẾNG ANH → 36 dòng&lt;br&gt;• Drive about → user &quot;Bảo Cao&quot;&lt;br&gt;• Slides → template &quot;Hóa Đơn Đất Thánh&quot;&lt;br&gt;• Render thật: Phòng 1 = 8.119.200 đ" style="fillColor=#f5f5f5;strokeColor=#666666;html=1;shape=note;size=14;fontSize=11;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1060" y="480" width="380" height="190" as="geometry"/>
        </mxCell>
